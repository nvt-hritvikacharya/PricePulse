{
  "name": "pricepulse-india",
  "version": "1.0.0",
  "private": true,
  "description": "PricePulse India - compare prices across Indian e-commerce sites, track history and set alerts.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/deploy-db.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "alerts:check": "tsx --env-file=.env scripts/check-alerts.ts",
    "vapid:generate": "web-push generate-vapid-keys",
    "test": "tsx --test tests/*.test.ts",
    "admin:grant": "tsx --env-file-if-exists=.env scripts/admin-role.ts grant",
    "admin:revoke": "tsx --env-file-if-exists=.env scripts/admin-role.ts revoke"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.80.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
