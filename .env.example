# ---------------------------------------------------------------------------
# PricePulse India - environment configuration
# Copy to `.env` and fill in what you have. Every external integration is
# optional: without keys the app runs in a fully usable "demo / mock" mode.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Long random string (>= 32 chars). Signs the session cookie. `openssl rand -base64 48`
# Optional: when unset, a key is derived from DATABASE_URL.
SESSION_SECRET=
# Inactivity timeout for sessions, in minutes
SESSION_IDLE_MINUTES=30
# Comma-separated emails/phones that get the ADMIN role on login
ADMIN_EMAILS=admin@pricepulse.dev

# --- Database / cache ---------------------------------------------------------
DATABASE_URL=postgresql://pricepulse:pricepulse@localhost:5432/pricepulse?schema=public
# If Redis is unreachable the app falls back to an in-process cache (single instance only).
REDIS_URL=redis://localhost:6379

# --- Sign-in codes (OTP) -------------------------------------------------------------
# Email codes (free tiers): set ONE of these.
#  - Brevo (https://www.brevo.com, ~300 emails/day free): API key from SMTP & API -> API keys.
#    The sender can be a single verified email address, no domain needed.
#  - Resend (https://resend.com, ~3,000 emails/month free): the sender must be on a domain verified in Resend.
#  - SMTP_URL (below) works too, e.g. Gmail with an app password.
BREVO_API_KEY=
RESEND_API_KEY=
# Must be a sender verified in Brevo / Resend.
OTP_EMAIL_FROM="PricePulse India <login@yourdomain.in>"
# SMS codes via Twilio Verify (https://www.twilio.com/docs/verify) - Twilio handles India DLT templates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# With none of the above in development, codes are printed in the server console instead.

# --- Google sign-in (optional, via Supabase OAuth) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Runtime alternatives to the two above (read on the server, not inlined at build time).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Set to "true" once Google is enabled as a provider in your Supabase project.
ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# --- Product photos (optional) ----------------------------------------------------------
# Google Programmable Search JSON API with image search enabled; SERPAPI_API_KEY (below) is used as a fallback.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Price providers ------------------------------------------------------------
# Amazon Product Advertising API 5.0 (requires an approved Amazon Associates India account)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

# Flipkart Affiliate API (https://affiliate.flipkart.com)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# SerpApi Google Shopping (gl=in) - covers Myntra, AJIO, Croma, Reliance Digital, Tata CLiQ,
# Nykaa, Vijay Sales, JioMart, Blinkit, Zepto, BigBasket (and Amazon/Flipkart if their own keys are missing)
SERPAPI_API_KEY=

# Mock provider: "auto" (only when no real provider is configured), "always" (blend in), "never"
MOCK_PROVIDER=auto

# Provider tuning
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2
# Search result cache TTL (seconds)
SEARCH_CACHE_TTL=900

# --- AI recommendation (OpenAI-compatible chat completions API) --------------------
# Works with OpenAI, Azure OpenAI-compatible gateways, Groq, OpenRouter, local Ollama etc.
# Without a key a deterministic, rule-based recommender is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Notifications ------------------------------------------------------------
# SMTP for price-alert emails. Without it, emails are logged + stored in the in-app inbox.
SMTP_URL=
EMAIL_FROM="PricePulse India <alerts@pricepulse.in>"
# Web push (generate with `npm run vapid:generate`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Runtime alternative to NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@pricepulse.in
# Protects /api/cron/check-alerts (call it from a scheduler with header `Authorization: Bearer <secret>`)
# The endpoint refuses every call while this is unset. `openssl rand -base64 32`
CRON_SECRET=
